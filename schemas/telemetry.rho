module telemetry

// The payloads a RoboHub node and this gateway exchange, and the ids that name
// them on the link.
//
// One schema, three ends: the node's C is generated from it, the gateway's Rho
// is generated from it, and both carry the same version byte and the same
// little-endian field order. The frame around a payload is robohub-transport's
// in both cases — a six-byte header, a Fletcher-16 check, COBS and a 0x00
// delimiter — and the gateway's copy of that framing is generated too, so what
// crosses the wire is one description, not two that must be kept in step.

namespace robohub.telemetry.v1

// The transport header's msg_id. The values are decimal because a schema enum
// takes a decimal literal; the hex each one stands for is in the comment.
enum MessageId {
    TELEMETRY = 513                 // 0x0201, unsolicited, tx_id 0
    SET_SAMPLING_RATE_REQUEST = 769 // 0x0301
    SET_SAMPLING_RATE_RESPONSE = 770 // 0x0302
}

enum NodeStatus {
    OK = 0
    FAULT = 1
}

// Telemetry is the 0x0201 payload, little-endian. `node_id` names the board the
// reading came from, so a gateway that hears several boards — directly or
// through a repeater — can attribute each reading without the link telling it.
message Telemetry {
    node_id: u16
    timestamp_ms: u32
    temperature_c: f32
    status: NodeStatus
}

// SetSamplingRate is the 0x0301 request and 0x0302 acknowledgement.
rpc SetSamplingRate {
    request {
        interval_ms: u16
    }
    response {
        actual_interval_ms: u16
    }
}

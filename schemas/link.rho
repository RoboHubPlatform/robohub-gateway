//
// @file link.rho
// @brief L2: the protocol between a board and the gateway it is wired to.
//
// The one source of the RoboHub wire protocol is robohub/protocol/schemas. Every
// other copy is written from it by robohub/protocol/tools/sync.py: edit it here,
// then run the tool, which also regenerates each consumer's code.
//
// @module robohub-protocol
// @project robohub-protocol
// @author Aurel Miron
// @date 2026-10-13
//
// SPDX-License-Identifier: MIT
//

module link

// L2 — the protocol between a board and the gateway it is wired to.
//
// The shared identity, the message numbering and the diagnostics and control
// families are in `common.rho`; what is here is what is particular to a board's
// side of its link: it announces itself (`HELLO`) and it sends readings
// (`TELEMETRY`). A board generates this schema and the C it becomes.
//
// The frame around a payload is robohub-transport's, the same one an uplink
// uses — a message is a message wherever it travels, and the level is which
// schema names it.

namespace robohub.v1

include "common.rho"

// What a device says about itself when it comes up, so a gateway knows it
// without being configured with it.
message Hello {
    device: DeviceId
    firmware_version: u16
    platform: Platform
    mode: Mode
    capabilities: u16
}

// A reading, naming its device. The reading carries its own identity, so a
// gateway that hears several boards — directly or through an edge — attributes
// each without the link telling it.
message Telemetry {
    device: DeviceId
    timestamp_ms: u32
    temperature_c: f32
    status: NodeStatus
}

// A board's health, once per boot (PROTO-0007, HEALTH 0x0403): why it last
// restarted, how many boots since power was applied, and the fault record the
// boot before left — its code (robohub/health.h rh_fault_code, or the
// application's own from 0x100), the task the runtime was running (0xFFFF for
// none), the program counter and the uptime then. A board with no record sends
// zeros and task 0xFFFF. `firmware_version` is HELLO's, so a report names the
// image that is reporting.
message Health {
    device: DeviceId
    reset_reason: ResetReason
    boot_count: u32
    fault_code: u32
    fault_task: u16
    fault_pc: u32
    fault_uptime_ms: u32
    firmware_version: u16
}

// What an update is, signed by the mesh's update key (PROTO-0008).
message UpdateManifest {
    update_id: u32
    uid: u8[8]
    firmware_version: u16
    security_version: u32
    size: u32
    sha256: u8[32]
    chunk_size: u16
}

// UPDATE_OFFER: the manifest and its Ed25519 signature.
message UpdateOffer {
    manifest: UpdateManifest
    signature: u8[64]
}

// UPDATE_STATUS: where the update stands, and what the board runs.
message UpdateStatus {
    update_id: u32
    state: UpdateState
    reason: UpdateReason
    next_index: u32
    running_version: u16
    running_slot: u8
}

// UPDATE_CANCEL: stop the update under way.
message UpdateCancel {
    update_id: u32
}

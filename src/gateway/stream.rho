module gateway.stream

// What a valid telemetry frame becomes: the latest state, per device, and one
// line for the collector.
//
// A reading names its device — an area and a node — and the state is keyed by
// both, because a tree of gateways has more than one area and a node id is
// unique only within its own. Two boards numbered 1 in different areas are two
// devices, and this is where that stops being an assumption and becomes a key.

// device_key packs an area and a node into the one number the port's device set
// holds: the area in the high half, the node in the low.
fn device_key(area: u32, node: u32) u32 {
    return (area << 16) | (node & 0xFFFF)
}

fn device_area(key: u32) u32 {
    return key >> 16
}

fn device_node(key: u32) u32 {
    return key & 0xFFFF
}

// device_suffix is the state key one field of one device lives under.
fn device_suffix(key: u32, suffix: string) string {
    return "node." + int_to_str(key) + suffix
}

// status_text is the schema's status as a word a person reads.
fn status_text(status: u32) string {
    if status != 0 {
        return "FAULT"
    }
    return "OK"
}

fn handle_telemetry(payload: string) void {
    if !telemetry_valid(payload) {
        return
    }
    let message: Telemetry = telemetry_unmarshal(payload)
    record_reading(u32(message.device.area_id), u32(message.device.node_id),
        message.timestamp_ms, message.temperature_c, message.status)
}

// handle_reading is the same record arriving on an uplink: a reading a relay
// carried up for a device it heard. The level differs and the fields do not, so
// both become one entry in the device's state — which is what makes a device the
// same device whether it is wired to this gateway or to one below it.
fn handle_reading(payload: string) void {
    if !reading_valid(payload) {
        return
    }
    let message: Reading = reading_unmarshal(payload)
    record_reading(u32(message.device.area_id), u32(message.device.node_id),
        message.timestamp_ms, message.temperature_c, u32(message.status))
}

// record_reading is what a reading from either level becomes: the device's
// newest values, and one line for the collector.
fn record_reading(area: u32, node: u32, timestamp: u32, temperature: f32, status: u32) void {
    let key: u32 = device_key(area, node)

    gateway_node_seen(key)
    gateway_state_set_f32(device_suffix(key, ".temperature_c"), temperature)
    gateway_state_set_u32(device_suffix(key, ".status"), status)
    gateway_state_set_u32(device_suffix(key, ".last_updated_ms"), timestamp)

    // The most recent frame, whichever device sent it, for the single reading
    // endpoint and for the stream.
    gateway_state_set_u32("latest_device", key)
    gateway_state_set_f32("temperature_c", temperature)
    gateway_state_set_u32("status", status)
    gateway_state_set_u32("last_updated_ms", timestamp)
    gateway_state_set_u32("frames", gateway_state_get_u32("frames") + 1)

    stream_publish(key, timestamp, temperature, status)
}

// stream_publish renders one PlotJuggler record and sends it. The device — its
// area and its node — is part of the record so a plot of several boards over
// several areas can be told apart.
fn stream_publish(key: u32, timestamp: u32, temperature: f32, status: u32) bool {
    let line: string = "{\"area_id\":" + int_to_str(device_area(key)) +
        ",\"node_id\":" + int_to_str(device_node(key)) +
        ",\"timestamp_ms\":" + int_to_str(timestamp) +
        ",\"temperature_c\":" + gateway_f32_str(temperature) +
        ",\"status\":" + int_to_str(status) + "}\n"
    return gateway_udp_send(line)
}

// handle_power_reading is a power device's reading, at either level: one message
// id and one set of fields, so a Growatt's Modbus figures and a Hoymiles's HTTP
// figures become the same device record.
fn handle_power_reading(payload: string) void {
    if !power_reading_valid(payload) {
        return
    }
    let message: PowerReading = power_reading_unmarshal(payload)
    record_power(message)
}

// record_power stores one power device's figures under its key and streams them.
// `has_power` marks the record as a power device, so the listing knows to render
// power fields rather than a temperature.
fn record_power(message: PowerReading) void {
    let key: u32 = device_key(u32(message.device.area_id), u32(message.device.node_id))

    gateway_node_seen(key)
    gateway_state_set_u32(device_suffix(key, ".has_power"), 1)
    gateway_state_set_u32(device_suffix(key, ".kind"), message.kind)
    gateway_state_set_u32(device_suffix(key, ".status"), u32(message.status))
    gateway_state_set_u32(device_suffix(key, ".valid"), u32(message.valid))
    gateway_state_set_f32(device_suffix(key, ".pv_power_w"), message.pv_power_w)
    gateway_state_set_f32(device_suffix(key, ".load_power_w"), message.load_power_w)
    gateway_state_set_f32(device_suffix(key, ".grid_power_w"), message.grid_power_w)
    gateway_state_set_f32(device_suffix(key, ".battery_power_w"), message.battery_power_w)
    gateway_state_set_f32(device_suffix(key, ".battery_soc"), message.battery_soc)
    gateway_state_set_f32(device_suffix(key, ".energy_today_kwh"), message.energy_today_kwh)
    gateway_state_set_f32(device_suffix(key, ".energy_total_kwh"), message.energy_total_kwh)
    gateway_state_set_u32(device_suffix(key, ".last_updated_ms"), message.timestamp_ms)

    // The newest power reading, whichever device sent it, for the single power
    // endpoint — kept apart from `latest_device`, which a sensor may have set.
    gateway_state_set_u32("latest_power_device", key)
    gateway_state_set_u32("frames", gateway_state_get_u32("frames") + 1)

    stream_publish_power(key, message)
}

// stream_publish_power renders one PlotJuggler record for a power device. It is
// its own record shape because the fields are its own; a plot selects the ones
// it wants by name.
fn stream_publish_power(key: u32, message: PowerReading) bool {
    let line: string = "{\"area_id\":" + int_to_str(device_area(key)) +
        ",\"node_id\":" + int_to_str(device_node(key)) +
        ",\"kind\":" + int_to_str(message.kind) +
        ",\"timestamp_ms\":" + int_to_str(message.timestamp_ms) +
        ",\"pv_power_w\":" + gateway_f32_str(message.pv_power_w) +
        ",\"load_power_w\":" + gateway_f32_str(message.load_power_w) +
        ",\"grid_power_w\":" + gateway_f32_str(message.grid_power_w) +
        ",\"battery_power_w\":" + gateway_f32_str(message.battery_power_w) +
        ",\"battery_soc\":" + gateway_f32_str(message.battery_soc) +
        ",\"energy_today_kwh\":" + gateway_f32_str(message.energy_today_kwh) +
        ",\"energy_total_kwh\":" + gateway_f32_str(message.energy_total_kwh) +
        ",\"status\":" + int_to_str(u32(message.status)) + "}\n"
    return gateway_udp_send(line)
}

module gateway.history

// The last frames, in a ring. The newest is row one on the page and in the
// export; the ring holds the last 1000 so the page can offer a window without
// keeping an unbounded log in the gateway's state.

const HISTORY_MAX: u32 = 1000

fn gateway_escape(text: string) string {
    var out: string = ""
    var i: u32 = 0
    let length: u32 = u32(strlen(text))
    while i < length {
        let ch: string = str_slice(text, i, 1)
        if ch == "&" {
            out = out + "&amp;"
        } else if ch == "<" {
            out = out + "&lt;"
        } else if ch == ">" {
            out = out + "&gt;"
        } else if ch == "\"" {
            out = out + "&quot;"
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

fn history_slot(index: u32, suffix: string) string {
    return "history." + int_to_str(index) + suffix
}

fn history_limit(raw: string) u32 {
    let value: u32 = int_from_str(raw)
    if value == 0 {
        return 10
    }
    if value > HISTORY_MAX {
        return HISTORY_MAX
    }
    return value
}

fn history_size() u32 {
    let count: u32 = gateway_state_get_u32("history.count")
    if count > HISTORY_MAX {
        return HISTORY_MAX
    }
    return count
}

// history_record appends one frame. `kind` says which message it was; `detail`
// carries the power or state fields as the JSON already rendered for the API.
fn history_record(kind: string, key: u32, timestamp: u32, temperature: f32,
                  status: u32, detail: string) void {
    let next: u32 = gateway_state_get_u32("history.next")
    gateway_state_set(history_slot(next, ".kind"), kind)
    gateway_state_set_u32(history_slot(next, ".area"), device_area(key))
    gateway_state_set_u32(history_slot(next, ".node"), device_node(key))
    gateway_state_set_u32(history_slot(next, ".timestamp_ms"), timestamp)
    gateway_state_set_f32(history_slot(next, ".temperature_c"), temperature)
    gateway_state_set_u32(history_slot(next, ".status"), status)
    gateway_state_set(history_slot(next, ".detail"), detail)
    gateway_state_set(history_slot(next, ".received_at_ms"), gateway_wall_time_ms())

    let count: u32 = gateway_state_get_u32("history.count") + 1
    gateway_state_set_u32("history.count", count)
    gateway_state_set_u32("history.size", history_size())
    gateway_state_set_u32("history.next", (next + 1) % HISTORY_MAX)
}

fn history_slot_for(age: u32) u32 {
    let next: u32 = gateway_state_get_u32("history.next")
    return (next + HISTORY_MAX - 1 - age) % HISTORY_MAX
}

fn history_shown(limit: u32) u32 {
    let size: u32 = history_size()
    if limit < size {
        return limit
    }
    return size
}

fn history_rows(limit: u32) string {
    let shown: u32 = history_shown(limit)
    if shown == 0 {
        return "<tr><td colspan=\"7\" class=\"empty\">No frames have arrived yet.</td></tr>"
    }
    var rows: string = ""
    var age: u32 = 0
    while age < shown {
        let slot: u32 = history_slot_for(age)
        let kind: string = gateway_state_get(history_slot(slot, ".kind"))
        let area: u32 = gateway_state_get_u32(history_slot(slot, ".area"))
        let node: u32 = gateway_state_get_u32(history_slot(slot, ".node"))
        let timestamp: u32 = gateway_state_get_u32(history_slot(slot, ".timestamp_ms"))
        var received: string = gateway_state_get(history_slot(slot, ".received_at_ms"))
        if received == "" {
            received = int_to_str(timestamp)
        }
        let status: string = status_text(gateway_state_get_u32(history_slot(slot, ".status")))
        var temperature: string = "—"
        if kind == "reading" {
            temperature = gateway_f32_str(gateway_state_get_f32(history_slot(slot, ".temperature_c")))
        }
        let detail: string = gateway_state_get(history_slot(slot, ".detail"))
        rows = rows + "<tr><td><span class=\"local-time\" data-ms=\"" +
            received + "\" title=\"" + int_to_str(timestamp) + " ms since node boot\">" +
            received + "</span></td><td>" + kind +
            "</td><td>" + int_to_str(area) + "</td><td>" + int_to_str(node) +
            "</td><td>" + temperature + "</td><td class=\"status-" + status + "\">" +
            status + "</td><td>" + gateway_escape(detail) + "</td></tr>"
        age = age + 1
    }
    return rows
}

fn history_select(limit: u32) string {
    var options: string = ""
    let choices: string = "10 25 50 100 500 1000"
    var rest: string = choices
    while rest != "" {
        let at: i32 = str_index_of(rest, " ")
        let choice: string = ""
        if at < 0 {
            choice = rest
            rest = ""
        } else {
            choice = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        if choice == "" {
            continue
        }
        var selected: string = ""
        if int_from_str(choice) == limit {
            selected = " selected"
        }
        options = options + "<option value=\"" + choice + "\"" + selected + ">" + choice + "</option>"
    }
    return "<label class=\"rows\">Frames <select onchange=\"location.href='/frames/'+this.value\">" +
        options + "</select></label>" +
        " <a class=\"export\" href=\"/export/frames/" + int_to_str(limit) + "/csv\">Export CSV</a>"
}

fn csv_field(value: string) string {
    var out: string = ""
    var i: u32 = 0
    let length: u32 = u32(strlen(value))
    while i < length {
        let ch: string = str_slice(value, i, 1)
        if ch == "\"" {
            out = out + "\"\""
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return "\"" + out + "\""
}

fn history_csv(limit: u32) string {
    var body: string = "timestamp_ms,received_at_ms,kind,area_id,node_id,temperature_c,status,detail\n"
    let shown: u32 = history_shown(limit)
    var age: u32 = 0
    while age < shown {
        let slot: u32 = history_slot_for(age)
        let kind: string = gateway_state_get(history_slot(slot, ".kind"))
        let area: u32 = gateway_state_get_u32(history_slot(slot, ".area"))
        let node: u32 = gateway_state_get_u32(history_slot(slot, ".node"))
        let timestamp: u32 = gateway_state_get_u32(history_slot(slot, ".timestamp_ms"))
        var received: string = gateway_state_get(history_slot(slot, ".received_at_ms"))
        if received == "" {
            received = int_to_str(timestamp)
        }
        let status: string = status_text(gateway_state_get_u32(history_slot(slot, ".status")))
        var temperature: string = ""
        if kind == "reading" {
            temperature = gateway_f32_str(gateway_state_get_f32(history_slot(slot, ".temperature_c")))
        }
        let detail: string = gateway_state_get(history_slot(slot, ".detail"))
        body = body + int_to_str(timestamp) + "," + received + "," + kind + "," + int_to_str(area) +
            "," + int_to_str(node) + "," + temperature + "," + status + "," +
            csv_field(detail) + "\n"
        age = age + 1
    }
    return body
}

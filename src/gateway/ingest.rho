module gateway.ingest

// What a frame from the link means.
//
// The framing and the payloads are generated (src/gateway/wire/protocol.rho):
// COBS, the Fletcher-16 check, the header and the message ids, the same as the
// firmware's robohub-transport. This is only the decision — unsolicited
// telemetry updates the state and the stream, and a response wakes the handler
// that is waiting on its tx_id.

fn ingest_frame(encoded: string) void {
    let received: TransportFrame = robohub_v1_unframe(encoded)
    if !received.ok {
        return
    }

    // A board opening a session; a frame sealed under one; or a plain frame,
    // which is only accepted while a deployment allows it (gateway/secure.rho).
    if received.msg_id == MESSAGE_ID_SECURE_HELLO {
        secure_handle_hello(received.payload)
        return
    }
    // The board a frame is from, when its session says so. It is what the
    // reading is kept under downstream; an unauthenticated frame has none.
    var frame: TransportFrame = received
    var source: string = ""
    if received.msg_id >= SECURE_FLAG {
        frame = secure_open(received)
        if !frame.ok {
            return
        }
        source = secure_frame_source(received)
    } else if !secure_plain_allowed() {
        let plain: u32 = gateway_state_get_u32("secure.plain_dropped")
        gateway_state_set_u32("secure.plain_dropped", plain + 1)
        return
    } else if gateway_state_get("secure.plain_warned") == "" {
        gateway_state_set("secure.plain_warned", "1")
        secure_log("accepting unauthenticated frames because ALLOW_PLAIN_FRAMES=1")
    }

    // tx_id 0 is unsolicited, so it is telemetry and no one is waiting for it.
    // A sensor sends `Telemetry`, a power device sends `PowerReading`; both are
    // measurements and both name their device, so the level and the message are
    // what tell them apart and neither is told which link it arrived on.
    if frame.tx_id == 0 {
        // A relay carries what it hears up to its parent as well.
        relay_forward(frame.msg_id, frame.payload)
        if frame.msg_id == MESSAGE_ID_TELEMETRY {
            handle_telemetry(source, frame.payload)
            return
        }
        if frame.msg_id == MESSAGE_ID_POWER_READING {
            handle_power_reading(source, frame.payload)
            return
        }
        if frame.msg_id == MESSAGE_ID_STATE_READING {
            handle_state_reading(source, frame.payload)
        }
        if frame.msg_id == MESSAGE_ID_SENSOR_READING {
            handle_sensor_reading(source, frame.payload)
        }
        return
    }

    // A non-zero tx_id answers a command this gateway sent. The payload is the
    // response — a control acknowledgement or a diagnostic — and the handler
    // waiting on the tx is the one that knows what it asked for, so any response
    // is handed on and validated there.
    if frame.msg_id == MESSAGE_ID_CONTROL_RESPONSE || frame.msg_id == MESSAGE_ID_DIAG_RESPONSE {
        // An answer to a command the parent routed through this relay goes back
        // up; any other wakes the handler here that asked.
        if !relay_answer(frame.msg_id, frame.tx_id, frame.payload) {
            gateway_rpc_signal(frame.tx_id, frame.payload)
        }
    }
}

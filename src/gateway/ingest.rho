module gateway.ingest

// What a frame from the link means.
//
// The framing and the payloads are generated (src/gateway/wire/protocol.rho):
// COBS, the Fletcher-16 check, the header and the message ids, the same as the
// firmware's robohub-transport. This is only the decision — unsolicited
// telemetry updates the state and the stream, and a response wakes the handler
// that is waiting on its tx_id.

fn ingest_frame(encoded: string) void {
    let frame: TransportFrame = robohub_v1_unframe(encoded)
    if !frame.ok {
        return
    }

    // tx_id 0 is unsolicited, so it is telemetry and no one is waiting for it.
    // A sensor sends `Telemetry`, a power device sends `PowerReading`; both are
    // measurements and both name their device, so the level and the message are
    // what tell them apart and neither is told which link it arrived on.
    if frame.tx_id == 0 {
        if frame.msg_id == MESSAGE_ID_TELEMETRY {
            handle_telemetry(frame.payload)
            return
        }
        if frame.msg_id == MESSAGE_ID_POWER_READING {
            handle_power_reading(frame.payload)
            return
        }
        if frame.msg_id == MESSAGE_ID_STATE_READING {
            handle_state_reading(frame.payload)
        }
        return
    }

    // A non-zero tx_id answers a command this gateway sent. The payload is the
    // response — a control acknowledgement or a diagnostic — and the handler
    // waiting on the tx is the one that knows what it asked for, so any response
    // is handed on and validated there.
    if frame.msg_id == MESSAGE_ID_CONTROL_RESPONSE || frame.msg_id == MESSAGE_ID_DIAG_RESPONSE {
        gateway_rpc_signal(frame.tx_id, frame.payload)
    }
}

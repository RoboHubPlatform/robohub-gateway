        return frame
    }
    let msg_id: u32 = u32(robohub_v1_get_u16(body, 0))
    let tx_id: u32 = u32(robohub_v1_get_u16(body, 2))
    let payload_len: u32 = u32(robohub_v1_get_u16(body, 4))
    if 6 + payload_len + 2 != total {
        return frame
    }
    let expected: u32 = u32(robohub_v1_get_u16(body, 6 + payload_len))
    let actual: u32 = robohub_v1_fletcher16(body, 6 + payload_len)
    if expected != actual {
        return frame
    }
    frame.msg_id = msg_id
    frame.tx_id = tx_id
    frame.payload = str_slice(body, 6, payload_len)
    frame.ok = true
    return frame
}


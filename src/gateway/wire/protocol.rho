// robohub_v1_fletcher16 is the check robohub-transport writes: two sums modulo 255,
// concatenated high byte first.
fn robohub_v1_fletcher16(data: string, length: u32) u32 {
    var sum1: u32 = 0
    var sum2: u32 = 0
    var i: u32 = 0
    while i < length {
        sum1 = (sum1 + u32(str_at(data, i)) % 255) % 255
        sum2 = (sum2 + sum1) % 255
        i = i + 1
    }
    return (sum2 << 8) | sum1
}

// robohub_v1_cobs_encode adds the Consistent Overhead Byte Stuffing a frame is sent
// with, without the delimiter the link appends.
fn robohub_v1_cobs_encode(input: string) string {
    let length: u32 = strlen(input)
    var out: string = ""
    var run: string = ""
    var run_length: u32 = 0
    var i: u32 = 0
    while i < length {
        let byte: u8 = str_at(input, i)
        if byte == u8(0) {
            out = out + str_from_byte(u8(run_length + 1)) + run
            run = ""
            run_length = 0
        } else {
            run = run + str_from_byte(byte)
            run_length = run_length + 1
            if run_length == 254 {
                out = out + str_from_byte(u8(255)) + run
                run = ""
                run_length = 0
            }
        }
        i = i + 1
    }
    return out + str_from_byte(u8(run_length + 1)) + run
}

// robohub_v1_cobs_decode reverses it, or returns "" when the frame is malformed.
fn robohub_v1_cobs_decode(input: string) string {
    let length: u32 = strlen(input)
    var out: string = ""
    var read: u32 = 0
    while read < length {
        let code: u32 = u32(str_at(input, read))
        read = read + 1
        if code == 0 {
            return ""
        }
        var i: u32 = 1
        while i < code {
            if read >= length {
                return ""
            }
            out = out + str_from_byte(str_at(input, read))
            read = read + 1
            i = i + 1
        }
        if code < 255 && read < length {
            out = out + str_from_byte(u8(0))
        }
    }
    return out
}

// robohub_v1_frame wraps a payload in the header and the check, then the stuffing.
// The link appends the 0x00 delimiter.
fn robohub_v1_frame(msg_id: u32, tx_id: u32, payload: string) string {
    var body: string = robohub_v1_put_u16(u16(msg_id)) + robohub_v1_put_u16(u16(tx_id)) + robohub_v1_put_u16(u16(strlen(payload))) + payload
    let check: u32 = robohub_v1_fletcher16(body, strlen(body))
    return robohub_v1_cobs_encode(body + robohub_v1_put_u16(u16(check)))
}

// robohub_v1_unframe decodes a frame and verifies it: the header, the length, and the
// Fletcher-16 check over everything before it.
fn robohub_v1_unframe(encoded: string) TransportFrame {
    var frame: TransportFrame
    frame.ok = false

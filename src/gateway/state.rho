module gateway.state

// The REST side: reading the latest state, and asking a node to change.
//
// The read is a lookup, because the reader has already parsed the frame. The
// write is an RPC: marshal the generated request, frame it with the generated
// robohub transport, write it, and wait for the acknowledgement that carries the
// caller's tx_id back.

// next_tx hands out the next transaction id. It is monotonic and shared with
// the reader through the port, so two handlers never choose the same one.
fn next_tx() u32 {
    let current: u32 = gateway_state_get_u32("tx")
    let next: u32 = current + 1
    gateway_state_set_u32("tx", next)
    return next
}

// gateway_error renders a JSON error, for the failure paths.
fn gateway_error(status: u32, message: string) Response {
    return Response{ status, "{\"success\":false,\"error\":\"" + message + "\"}", "application/json" }
}

// latest_temperature serves the newest telemetry, from whichever board sent it
// last, or a zero reading before any frame has arrived.
fn latest_temperature(req: Request) Response {
    let id: u32 = gateway_state_get_u32("latest_node")
    let body: string = "{\"node_id\":" + int_to_str(id) +
        ",\"temperature_c\":" + gateway_f32_str(gateway_state_get_f32("temperature_c")) +
        ",\"status\":\"" + status_text(gateway_state_get_u32("status")) +
        "\",\"last_updated_ms\":" + int_to_str(gateway_state_get_u32("last_updated_ms")) + "}"
    return json(200, body)
}

// nodes lists every board a frame has come from, with its newest values.
fn nodes(req: Request) Response {
    var body: string = "["
    let count: u32 = gateway_node_count()
    var i: u32 = 0
    while i < count {
        let id: u32 = gateway_node_at(i)
        if i > 0 {
            body = body + ","
        }
        body = body + node_reading(id)
        i = i + 1
    }
    return json(200, body + "]")
}

// node_reading is one board's newest values, as the listing renders it.
fn node_reading(id: u32) string {
    return "{\"node_id\":" + int_to_str(id) +
        ",\"temperature_c\":" + gateway_f32_str(gateway_state_get_f32(node_key(id, ".temperature_c"))) +
        ",\"status\":\"" + status_text(gateway_state_get_u32(node_key(id, ".status"))) +
        "\",\"last_updated_ms\":" + int_to_str(gateway_state_get_u32(node_key(id, ".last_updated_ms"))) + "}"
}

// set_sampling_rate marshals and frames a 0x0301 command, sends it, and waits
// for the 0x0302 acknowledgement, answering 504 when the node does not reply.
fn set_sampling_rate(req: Request) Response {
    let interval: u32 = parse_interval_ms(request_body(req))
    if interval == 0 {
        return gateway_error(400, "interval_ms is required and must be positive")
    }

    let tx: u32 = next_tx()
    gateway_rpc_register(tx)

    let request: SetSamplingRateRequest = SetSamplingRateRequest { u16(interval) }
    let encoded: string = robohub_telemetry_v1_frame(
        MESSAGE_ID_SET_SAMPLING_RATE_REQUEST, tx, set_sampling_rate_request_marshal(request))
    if !gateway_serial_write(encoded) {
        return gateway_error(503, "the serial link is unavailable")
    }

    let response: string = gateway_rpc_wait(tx, 2000)
    if strlen(response) == 0 {
        return gateway_error(504, "the node did not acknowledge in 2000 ms")
    }
    if !set_sampling_rate_response_valid(response) {
        return gateway_error(502, "the node sent a malformed acknowledgement")
    }
    let acknowledgement: SetSamplingRateResponse = set_sampling_rate_response_unmarshal(response)
    return json(200, "{\"success\":true,\"actual_interval_ms\":" +
        int_to_str(u32(acknowledgement.actual_interval_ms)) + "}")
}

// parse_interval_ms reads the number after "interval_ms" in a small JSON body,
// which is enough for the one field this endpoint takes.
fn parse_interval_ms(body: string) u32 {
    let at: i32 = str_index_of(body, "\"interval_ms\"")
    if at < 0 {
        return 0
    }
    let length: u32 = strlen(body)
    var i: u32 = u32(at)
    while i < length && str_at(body, i) != u8(58) {
        i = i + 1
    }
    i = i + 1
    while i < length && (str_at(body, i) == u8(32) || str_at(body, i) == u8(9)) {
        i = i + 1
    }
    var digits: string = ""
    while i < length {
        let c: u8 = str_at(body, i)
        if c < u8(48) || c > u8(57) {
            break
        }
        digits = digits + str_from_byte(c)
        i = i + 1
    }
    return int_from_str(digits)
}

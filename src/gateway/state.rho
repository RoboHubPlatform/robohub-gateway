module gateway.state

// The REST side: reading the latest state, asking a device to change, and saying
// what the gateway itself is doing.
//
// The read is a lookup, because the reader has already parsed the frame. The
// write is a control: marshal the generated request for the device, frame it
// with the generated robohub transport, write it, and wait for the
// acknowledgement that carries the caller's tx_id back.

// next_tx hands out the next transaction id. It is monotonic and shared with
// the reader through the port, so two handlers never choose the same one.
fn next_tx() u32 {
    let current: u32 = gateway_state_get_u32("tx")
    let next: u32 = current + 1
    gateway_state_set_u32("tx", next)
    return next
}

// gateway_error renders a JSON error, for the failure paths.
fn gateway_error(status: u32, message: string) Response {
    return Response{ status, "{\"success\":false,\"error\":\"" + message + "\"}", "application/json" }
}

/* -------------------------------------------------------------------------- */
/*  The uplink                                                                */
/* -------------------------------------------------------------------------- */

// drain_uplink applies every frame an uplink has sent since the last time it
// was drained. The listener queues what arrives while the service is idle, and
// this empties the queue — a request-driven service processes what it did not
// ask for when it is asked for something.
fn drain_uplink() u32 {
    var applied: u32 = 0
    var guard: u32 = 0
    while guard < 4096 {
        let frame: string = gateway_uplink_next()
        if strlen(frame) == 0 {
            break
        }
        apply_uplink_frame(frame)
        applied = applied + 1
        guard = guard + 1
    }
    return applied
}

// apply_uplink_frame decides what one uplink frame means. A reading is a device
// this gateway does not hear directly — a board behind a relay — and becomes the
// same device record a local reading would. An announce says which gateway is
// below and the area it speaks for, which is what a command is routed down by.
fn apply_uplink_frame(encoded: string) void {
    let frame: TransportFrame = robohub_v1_unframe(encoded)
    if !frame.ok {
        return
    }

    if frame.msg_id == MESSAGE_ID_READING {
        handle_reading(frame.payload)
        return
    }

    // A power reading carried up is the same message a power device sends
    // directly, so a relay re-frames it and the master records it identically.
    if frame.msg_id == MESSAGE_ID_POWER_READING {
        handle_power_reading(frame.payload)
        return
    }

    if frame.msg_id == MESSAGE_ID_STATE_READING {
        handle_state_reading(frame.payload)
        return
    }

    // A response from a child — to a command this gateway routed down — wakes
    // the handler waiting on that transaction, exactly as one from the local
    // link does.
    if frame.msg_id == MESSAGE_ID_CONTROL_RESPONSE || frame.msg_id == MESSAGE_ID_DIAG_RESPONSE {
        if frame.tx_id != 0 {
            gateway_rpc_signal(frame.tx_id, frame.payload)
            // A command routed down is answered here, not in the request that
            // routed it, so the answer is kept where the transaction id names it.
            if control_response_valid(frame.payload) {
                let ack: ControlResponse = control_response_unmarshal(frame.payload)
                gateway_state_set_u32("ack." + int_to_str(frame.tx_id), ack.argument)
            }
        }
        return
    }

    if frame.msg_id == MESSAGE_ID_ANNOUNCE && announce_valid(frame.payload) {
        let announce: Announce = announce_unmarshal(frame.payload)
        let child: u32 = device_key(u32(announce.gateway.area_id), u32(announce.gateway.link_id))
        // Bind the child to the link it announced itself on, so a command for
        // its area can be sent back down the way the announcement came up.
        gateway_uplink_bind(u32(announce.gateway.area_id), u32(announce.gateway.link_id),
            gateway_uplink_connection())
        gateway_state_set_u32("child." + int_to_str(child), u32(announce.area_id))
        // The area it speaks for, so a device in that area is known to be behind
        // it rather than on this gateway's own link.
        gateway_state_set_u32("area." + int_to_str(u32(announce.area_id)), child)
        gateway_state_set_u32("children", gateway_state_get_u32("children") + 1)
    }
}

// uplink_pump drains the uplink and says how many frames it applied, so a
// supervisor can drive a master that nothing else is asking yet.
fn uplink_pump(req: Request) Response {
    let applied: u32 = drain_uplink()
    return json(200, "{\"applied\":" + int_to_str(applied) + "}")
}

// latest_temperature serves the newest telemetry, from whichever device sent it
// last, or a zero reading before any frame has arrived.
fn latest_temperature(req: Request) Response {
    drain_uplink()
    let key: u32 = gateway_state_get_u32("latest_device")
    let body: string = "{\"area_id\":" + int_to_str(device_area(key)) +
        ",\"node_id\":" + int_to_str(device_node(key)) +
        ",\"temperature_c\":" + gateway_f32_str(gateway_state_get_f32("temperature_c")) +
        ",\"status\":\"" + status_text(gateway_state_get_u32("status")) +
        "\",\"last_updated_ms\":" + int_to_str(gateway_state_get_u32("last_updated_ms")) + "}"
    return json(200, body)
}

// nodes lists every device a frame has come from, with its newest values.
fn nodes(req: Request) Response {
    drain_uplink()
    var body: string = "["
    let count: u32 = gateway_node_count()
    var i: u32 = 0
    while i < count {
        let key: u32 = gateway_node_at(i)
        if i > 0 {
            body = body + ","
        }
        body = body + node_reading(key)
        i = i + 1
    }
    return json(200, body + "]")
}

// node_reading is one device's newest values, as the listing renders it. A
// device whose smoke has been run carries its last diagnostic too, so a listing
// says both what it last read and whether it is well. A power device carries its
// power and energy figures instead of a spot temperature.
fn node_reading(key: u32) string {
    var body: string = "{\"area_id\":" + int_to_str(device_area(key)) +
        ",\"node_id\":" + int_to_str(device_node(key)) +
        ",\"temperature_c\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".temperature_c"))) +
        ",\"status\":\"" + status_text(gateway_state_get_u32(device_suffix(key, ".status"))) +
        "\",\"last_updated_ms\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".last_updated_ms"))) +
        ",\"received_at_ms\":" + received_at(key)

    if gateway_state_get_u32(device_suffix(key, ".has_power")) != 0 {
        body = body + power_json(key)
    }

    // A device's state (a switch, an actuator) is rendered beside its figures.
    // `kind` and `valid` belong to the device, so they are written once — with
    // the power figures when there are any, and here when state is all there is.
    if gateway_state_get_u32(device_suffix(key, ".has_state")) != 0 {
        if gateway_state_get_u32(device_suffix(key, ".has_power")) == 0 {
            body = body + ",\"kind\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".kind"))) +
                ",\"valid\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".valid")))
        }
        body = body + state_json(key)
    }

    // Splice the stored diagnostic in before the closing brace, rather than
    // keeping it apart: a device is one record, and a reader wants one.
    if gateway_state_get_u32(device_suffix(key, ".diag_set")) != 0 {
        body = body + ",\"diag\":" + gateway_state_get(device_suffix(key, ".diag"))
    }
    return body + "}"
}

// state_json renders a device's stored state, as the trailing fields of its
// record. It starts with a comma, because it is always appended.
fn state_json(key: u32) string {
    return ",\"switch_state\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".switch_state"))) +
        ",\"setpoint\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".setpoint")))
}

// power_json renders a power device's stored figures, as the trailing fields of
// its record. It starts with a comma, because it is always appended to a record
// that already has the identity and the timestamp.
fn power_json(key: u32) string {
    return ",\"kind\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".kind"))) +
        ",\"valid\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".valid"))) +
        ",\"pv_power_w\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".pv_power_w"))) +
        ",\"load_power_w\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".load_power_w"))) +
        ",\"grid_power_w\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".grid_power_w"))) +
        ",\"battery_power_w\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".battery_power_w"))) +
        ",\"battery_soc\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".battery_soc"))) +
        ",\"energy_today_kwh\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".energy_today_kwh"))) +
        ",\"energy_total_kwh\":" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".energy_total_kwh")))
}

// latest_power serves the newest power reading, from whichever device sent it
// last, or a zero reading before any has arrived.
fn latest_power(req: Request) Response {
    drain_uplink()
    let key: u32 = gateway_state_get_u32("latest_power_device")
    let body: string = "{\"area_id\":" + int_to_str(device_area(key)) +
        ",\"node_id\":" + int_to_str(device_node(key)) +
        ",\"status\":\"" + status_text(gateway_state_get_u32(device_suffix(key, ".status"))) +
        "\",\"last_updated_ms\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".last_updated_ms"))) +
        ",\"received_at_ms\":" + received_at(key)
    return json(200, body + power_json(key) + "}")
}

// latest_state serves the newest device state, from whichever device sent it
// last, or a zero state before any has arrived.
fn latest_state(req: Request) Response {
    drain_uplink()
    let key: u32 = gateway_state_get_u32("latest_state_device")
    let body: string = "{\"area_id\":" + int_to_str(device_area(key)) +
        ",\"node_id\":" + int_to_str(device_node(key)) +
        ",\"kind\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".kind"))) +
        ",\"status\":\"" + status_text(gateway_state_get_u32(device_suffix(key, ".status"))) +
        "\",\"last_updated_ms\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".last_updated_ms"))) +
        ",\"received_at_ms\":" + received_at(key) +
        ",\"valid\":" + int_to_str(gateway_state_get_u32(device_suffix(key, ".valid")))
    return json(200, body + state_json(key) + "}")
}

// diagnostics says what the gateway itself is doing: the mode it was deployed
// in, the area it speaks for, how long it has been up, and what it has carried.
fn diagnostics(req: Request) Response {
    drain_uplink()
    let body: string = "{\"mode\":\"" + gateway_mode() + "\"" +
        ",\"area_id\":" + int_to_str(gateway_area()) +
        ",\"uptime_ms\":" + int_to_str(gateway_now_ms()) +
        ",\"devices_seen\":" + int_to_str(gateway_node_count()) +
        ",\"children\":" + int_to_str(gateway_state_get_u32("children")) +
        ",\"frames\":" + int_to_str(gateway_state_get_u32("frames")) + "}"
    return json(200, body)
}

// home is the gateway's own page: what it is doing and the nodes it has heard
// from. The REST API is what a program reads; this is what a person opens at the
// root of the same server.
fn received_at(key: u32) string {
    let value: string = gateway_state_get(device_suffix(key, ".received_at_ms"))
    if value == "" {
        return int_to_str(gateway_state_get_u32(device_suffix(key, ".last_updated_ms")))
    }
    return value
}

fn home_with_limit(req: Request, limit: u32) Response {
    drain_uplink()
    let count: u32 = gateway_node_count()
    var rows: string = ""
    var i: u32 = 0
    while i < count {
        let key: u32 = gateway_node_at(i)
        let status: string = status_text(gateway_state_get_u32(device_suffix(key, ".status")))
        rows = rows + "<tr><td>" + int_to_str(device_area(key)) +
            "</td><td>" + int_to_str(device_node(key)) +
            "</td><td>" + gateway_f32_str(gateway_state_get_f32(device_suffix(key, ".temperature_c"))) +
            "</td><td class=\"status-" + status + "\">" + status +
            "</td><td><span class=\"local-time\" data-ms=\"" +
            received_at(key) + "\" title=\"" +
            int_to_str(gateway_state_get_u32(device_suffix(key, ".last_updated_ms"))) +
            " ms since node boot\">" + received_at(key) + "</span></td></tr>"
        i = i + 1
    }
    if count == 0 {
        rows = "<tr><td colspan=\"5\" class=\"empty\">No node has been heard from yet.</td></tr>"
    }
    let body: string = "<!doctype html><html><head><meta charset=\"utf-8\">" +
        "<meta http-equiv=\"refresh\" content=\"2\">" +
        "<title>RoboHub Gateway</title><style>" +
        "body{font-family:system-ui,sans-serif;max-width:74rem;margin:2rem auto;padding:0 1rem;color:#1e232b;background:#f7f8fa}" +
        "h1{margin-bottom:.2rem} .meta{color:#5d6673} table{border-collapse:collapse;width:100%;background:#fff;border:1px solid #dfe3e9;border-radius:10px;overflow:hidden}" +
        "th,td{padding:.6rem .8rem;text-align:left;border-top:1px solid #eef1f5} th{background:#f1f3f6;font-size:.8rem;color:#5d6673}" +
        ".empty{text-align:center;color:#8a929e;padding:1.5rem}.status-OK{color:#19734d;font-weight:600}.status-FAULT{color:#b3261e;font-weight:600}" +
        "a{color:#245db3} code{background:#eef1f5;padding:.1rem .3rem;border-radius:4px}" +
        "</style></head><body><h1>RoboHub Gateway</h1>" +
        "<p class=\"meta\">mode <strong>" + gateway_mode() + "</strong> · area " +
        int_to_str(gateway_area()) + " · up " + int_to_str(gateway_now_ms() / 1000) +
        " s · devices " + int_to_str(count) + " · frames " +
        int_to_str(gateway_state_get_u32("frames")) + "</p>" +
        "<table><thead><tr><th>Area</th><th>Node</th><th>Temperature °C</th><th>Status</th><th>Last update (ms)</th></tr></thead><tbody>" +
        rows + "</tbody></table>" +
        "<h2>Frames</h2><p class=\"meta\">" + history_select(limit) + "</p>" +
        "<table><thead><tr><th>Time (ms)</th><th>Kind</th><th>Area</th><th>Node</th>" +
        "<th>Temperature °C</th><th>Status</th><th>Detail</th></tr></thead><tbody>" +
        history_rows(limit) + "</tbody></table>" +
        "<p class=\"meta\">API: <a href=\"/api/v1/nodes\">nodes</a> · " +
        "<a href=\"/api/v1/telemetry/temperature\">temperature</a> · " +
        "<a href=\"/api/v1/diagnostics\">diagnostics</a> · " +
        "<a href=\"/healthz\">health</a></p>" +
        "<script>document.querySelectorAll('.local-time').forEach(function (el) {" +
        "var ms = Number(el.getAttribute('data-ms'));" +
        "if (ms > 0) { el.textContent = new Date(ms).toLocaleString(); }});</script>" +
        "</body></html>"
    return html(200, body)
}

fn home(req: Request) Response {
    return home_with_limit(req, 10)
}

fn frames(req: Request) Response {
    return home_with_limit(req, history_limit(param(req, "count")))
}

fn export_frames_csv(req: Request) Response {
    let limit: u32 = history_limit(param(req, "count"))
    return Response{ 200, history_csv(limit), "text/csv; charset=utf-8" }
}

// set_sampling_rate marshals and frames a control request for a device, sends
// it, and waits for the acknowledgement that carries the caller's tx_id,
// answering 504 when the device does not reply.
//
// It addresses the device that sent the latest reading. The control family is
// general — an opcode and an argument — so a second command is another opcode,
// not another endpoint.
fn set_sampling_rate(req: Request) Response {
    let interval: u32 = parse_interval_ms(request_body(req))
    if interval == 0 {
        return gateway_error(400, "interval_ms is required and must be positive")
    }
    let key: u32 = gateway_state_get_u32("latest_device")
    if key == 0 {
        return gateway_error(503, "no device has been heard from yet")
    }
    return route_control(device_area(key), device_node(key), u16(CONTROL_OPCODE_SET_SAMPLING_RATE), interval)
}

// device_diagnostics asks one device to run its hardware smoke and records the
// answer. The mask asks for every probe; a board answers for the ones it has,
// and a probe it does not have is absent rather than failed. The answer is kept
// with the device, so the listing carries the last smoke as well as the last
// reading.
fn device_diagnostics(req: Request) Response {
    let area: u32 = int_from_str(param(req, "area"))
    let node: u32 = int_from_str(param(req, "node"))
    if area == 0 {
        return gateway_error(400, "a device is an area and a node, and the area is required")
    }
    let key: u32 = device_key(area, node)

    let tx: u32 = next_tx()
    gateway_rpc_register(tx)

    let device: DeviceId = DeviceId { u16(area), u16(node) }
    let request: DiagRequest = DiagRequest { device, 255 }
    let encoded: string = robohub_v1_frame(
        MESSAGE_ID_DIAG_REQUEST, tx, diag_request_marshal(request))
    if !gateway_serial_write(encoded) {
        return gateway_error(503, "the serial link is unavailable")
    }

    let response: string = gateway_rpc_wait(tx, 2000)
    if strlen(response) == 0 {
        return gateway_error(504, "the device did not answer in 2000 ms")
    }
    if !diag_response_valid(response) {
        return gateway_error(502, "the device sent a malformed diagnostic")
    }

    let diag: DiagResponse = diag_response_unmarshal(response)
    let body: string = diag_json(diag)
    gateway_state_set(device_suffix(key, ".diag"), body)
    gateway_state_set_u32(device_suffix(key, ".diag_set"), 1)
    return json(200, body)
}

// diag_json renders a diagnostic response as the REST shape.
fn diag_json(diag: DiagResponse) string {
    return "{\"area_id\":" + int_to_str(u32(diag.device.area_id)) +
        ",\"node_id\":" + int_to_str(u32(diag.device.node_id)) +
        ",\"uptime_ms\":" + int_to_str(diag.uptime_ms) +
        ",\"events_published\":" + int_to_str(diag.events_published) +
        ",\"handler_errors\":" + int_to_str(diag.handler_errors) +
        ",\"tasks_run\":" + int_to_str(diag.tasks_run) +
        ",\"task_errors\":" + int_to_str(diag.task_errors) +
        ",\"last_error\":" + int_to_str(u32(diag.last_error)) +
        ",\"probe_ok\":" + int_to_str(diag.probe_ok) +
        ",\"probe_fault\":" + int_to_str(diag.probe_fault) + "}"
}

// route_control sends one command to one device and answers with what it did.
//
// The control family is an opcode and an argument, so every command routes the
// same way: a device in a child's area goes down that child's uplink and is
// answered asynchronously; a device on this gateway's own link is answered in
// the request. A typed endpoint is a thin wrapper over this.
fn route_control(area: u32, node: u32, opcode: u16, argument: u32) Response {
    let tx: u32 = next_tx()
    let device: DeviceId = DeviceId { u16(area), u16(node) }
    let control: ControlRequest = ControlRequest { device, opcode, argument }
    let encoded: string = robohub_v1_frame(
        MESSAGE_ID_CONTROL_REQUEST, tx, control_request_marshal(control))

    let child: u32 = gateway_state_get_u32("area." + int_to_str(area))
    if child != 0 {
        if !gateway_uplink_send(device_area(child), device_node(child), encoded) {
            return gateway_error(503, "the child that owns that area is not connected")
        }
        return json(202, "{\"success\":true,\"routed\":true,\"tx\":" + int_to_str(tx) + "}")
    }

    gateway_rpc_register(tx)
    if !gateway_serial_write(encoded) {
        return gateway_error(503, "the serial link is unavailable")
    }

    let response: string = gateway_rpc_wait(tx, 2000)
    if strlen(response) == 0 {
        return gateway_error(504, "the device did not acknowledge in 2000 ms")
    }
    if !control_response_valid(response) {
        return gateway_error(502, "the device sent a malformed acknowledgement")
    }
    let acknowledgement: ControlResponse = control_response_unmarshal(response)
    if acknowledgement.result != 0 {
        return gateway_error(502, "the device refused the command")
    }
    return json(200, "{\"success\":true,\"opcode\":" + int_to_str(u32(opcode)) +
        ",\"actual\":" + int_to_str(acknowledgement.argument) + "}")
}

// device_sampling_rate changes one device's reporting interval: opcode 1, the
// interval as the argument.
fn device_sampling_rate(req: Request) Response {
    let area: u32 = int_from_str(param(req, "area"))
    let node: u32 = int_from_str(param(req, "node"))
    let interval: u32 = parse_interval_ms(request_body(req))
    if area == 0 || interval == 0 {
        return gateway_error(400, "an area, a node and a positive interval_ms are required")
    }
    return route_control(area, node, u16(CONTROL_OPCODE_SET_SAMPLING_RATE), interval)
}

// device_command is the control family at its most general: any opcode and
// argument, addressed to a named device. A device's own opcodes begin at
// CONTROL_OPCODE_VENDOR_BASE, so a custom command cannot collide with a core one.
fn device_command(req: Request) Response {
    let area: u32 = int_from_str(param(req, "area"))
    let node: u32 = int_from_str(param(req, "node"))
    let body: string = request_body(req)
    let opcode: u32 = parse_u32_field(body, "\"opcode\"")
    if area == 0 || opcode == 0 {
        return gateway_error(400, "an area, a node and an opcode are required")
    }
    let argument: u32 = parse_u32_field(body, "\"argument\"")
    return route_control(area, node, u16(opcode), argument)
}

// device_switch drives a switch: opcode SET_SWITCH, the argument 1 for on and 0
// for off.
fn device_switch(req: Request) Response {
    let area: u32 = int_from_str(param(req, "area"))
    let node: u32 = int_from_str(param(req, "node"))
    if area == 0 {
        return gateway_error(400, "an area and a node are required")
    }
    var on: u32 = 0
    if parse_bool_field(request_body(req), "\"on\"") {
        on = 1
    }
    return route_control(area, node, u16(CONTROL_OPCODE_SET_SWITCH), on)
}

// parse_u32_field reads the unsigned number after a JSON key in a small request
// body, which is enough for the fields these endpoints take.
fn parse_u32_field(body: string, key: string) u32 {
    let at: i32 = str_index_of(body, key)
    if at < 0 {
        return 0
    }
    let length: u32 = strlen(body)
    var i: u32 = u32(at)
    while i < length && str_at(body, i) != u8(58) {
        i = i + 1
    }
    i = i + 1
    while i < length && (str_at(body, i) == u8(32) || str_at(body, i) == u8(9)) {
        i = i + 1
    }
    var digits: string = ""
    while i < length {
        let c: u8 = str_at(body, i)
        if c < u8(48) || c > u8(57) {
            break
        }
        digits = digits + str_from_byte(c)
        i = i + 1
    }
    return int_from_str(digits)
}

// parse_interval_ms reads the reporting interval from a request body.
fn parse_interval_ms(body: string) u32 {
    return parse_u32_field(body, "\"interval_ms\"")
}

// parse_bool_field reads a JSON boolean (or 0/1) after a key.
fn parse_bool_field(body: string, key: string) bool {
    let at: i32 = str_index_of(body, key)
    if at < 0 {
        return false
    }
    let length: u32 = strlen(body)
    var i: u32 = u32(at)
    while i < length && str_at(body, i) != u8(58) {
        i = i + 1
    }
    i = i + 1
    while i < length && (str_at(body, i) == u8(32) || str_at(body, i) == u8(9)) {
        i = i + 1
    }
    if i + 3 < length && str_at(body, i) == u8(116) && str_at(body, i + 1) == u8(114) &&
        str_at(body, i + 2) == u8(117) && str_at(body, i + 3) == u8(101) {
        return true /* "true" */
    }
    return i < length && str_at(body, i) == u8(49) /* "1" */
}

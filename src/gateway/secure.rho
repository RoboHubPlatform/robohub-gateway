module gateway.secure

// Authenticated frames between this gateway and its boards.
//
// The protocol is robohub-transport's (include/robohub/secure.h), and this is its
// gateway half. The gateway holds one key, read from GATEWAY_KEY_FILE (64 hex
// digits in a file only its user can read), and derives each board's key from
// it and the board's id, so a board's key is never stored or sent:
//
//   K_dev  = HMAC-SHA256(K_gw, "rh-dev1" | uid)[0:16]
//
// That is epoch 0 of the board's key; a rotated key is a later epoch, and which
// epoch a hello is tried under is gateway/keys.rho's to say.
//
// A board says hello; the gateway answers with a session bound to the board's
// nonce, and from then on every frame either way carries a counter and a tag.
// A frame that does not open is dropped. A plain frame is dropped too, unless
// the deployment sets ALLOW_PLAIN_FRAMES=1 while boards are being reflashed, in
// which case it is accepted and a warning is logged. That allowance is the
// serial link's alone: the uplink is a network, and a plain frame on it is never
// taken.
//
// Which boards may open a session at all is the node manifest's to say
// (gateway/manifest.rho): with one, a board that is not in it, or is revoked,
// is not answered, and a session is held to the connection it was opened on.

extern fn rho_hmac_sha256_hex(key_hex: string, message_hex: string) string
extern fn rho_random_hex(bytes: u32) string
extern fn rho_read_text(path: string) string
extern fn rho_write_secret(path: string, text: string) bool
extern fn rho_now_s() u32

const SECURE_FLAG: u32 = 32768
const MESSAGE_ID_SECURE_HELLO: u32 = 17
const MESSAGE_ID_SECURE_SESSION: u32 = 18
const SECURE_LIFETIME_S: u32 = 3600
// A session's counters are kept on disk whenever one has moved this far past
// what was last kept, and a session restored after a restart takes up twice as
// far past it: a frame recorded before the restart cannot be replayed after it.
const SECURE_STORE_EVERY: u32 = 64
// How many of a board's latest hello nonces are remembered, so a recorded hello
// is not answered again.
const SECURE_NONCES_KEPT: u32 = 8
// A hello that does not authenticate is said at most once in this many seconds.
const SECURE_BAD_HELLO_QUIET_S: u32 = 60
// A board that goes on under a session restored after a restart counts below
// the restored mark, and its frames are refused until it passes it. It is asked
// for a new session instead (SESSION_RESET): at most once in this many seconds
// per session, and this many times in all.
const SECURE_RESET_RETRY_S: u32 = 10
const SECURE_RESET_TRIES: u32 = 5
// The reason byte a SESSION_RESET carries: the gateway restarted.
const SECURE_RESET_REASON_RESTART: u32 = 1

// The labels the protocol hashes, as hex.
const SECURE_LABEL_DEV: string = "72682d64657631"
const SECURE_LABEL_HELLO: string = "72682d68656c6c6f31"
const SECURE_LABEL_SESSION: string = "72682d73657373696f6e31"
const SECURE_LABEL_UP: string = "72682d757031"
const SECURE_LABEL_DOWN: string = "72682d646f776e31"

// secure_log writes a line the way the rest of the gateway does.
fn secure_log(message: string) void {
    print("robohub-gateway: " + message + "\n")
}

fn secure_hex_digit(value: u32) string {
    return str_slice("0123456789abcdef", value, 1)
}

// secure_hex is a byte string as hex.
fn secure_hex(data: string) string {
    var out: string = ""
    var i: u32 = 0
    while i < strlen(data) {
        let byte: u32 = u32(str_at(data, i))
        out = out + secure_hex_digit(byte / 16) + secure_hex_digit(byte % 16)
        i = i + 1
    }
    return out
}

fn secure_hex_value(digit: string) u32 {
    let at: i32 = str_index_of("0123456789abcdef", digit)
    if at < 0 {
        return 0
    }
    return u32(at)
}

// secure_bytes is hex as a byte string.
fn secure_bytes(hex: string) string {
    var out: string = ""
    var i: u32 = 0
    while i + 1 < strlen(hex) {
        out = out + str_from_byte(u8(secure_hex_value(str_slice(hex, i, 1)) * 16 +
            secure_hex_value(str_slice(hex, i + 1, 1))))
        i = i + 2
    }
    return out
}

// secure_tag is the first eight bytes of HMAC-SHA256, as hex.
fn secure_tag(key_hex: string, message_hex: string) string {
    return str_slice(rho_hmac_sha256_hex(key_hex, message_hex), 0, 16)
}

// secure_equal compares two tags without stopping at the first difference, so
// the time a comparison takes does not say how much of a forged tag was right.
// The lengths are not secret; a tag is always 16 hex digits.
fn secure_equal(a: string, b: string) bool {
    if strlen(a) != strlen(b) {
        return false
    }
    var difference: u32 = 0
    var i: u32 = 0
    while i < strlen(a) {
        difference = difference | (u32(str_at(a, i)) ^ u32(str_at(b, i)))
        i = i + 1
    }
    return difference == 0
}

fn secure_gateway_key() string {
    let cached: string = gateway_state_get("secure.k_gw")
    if cached != "" {
        return cached
    }
    let path: string = getenv("GATEWAY_KEY_FILE")
    if path == "" {
        return ""
    }
    var key: string = rho_read_text(path)
    while strlen(key) > 0 && (str_slice(key, strlen(key) - 1, 1) == "\n" || str_slice(key, strlen(key) - 1, 1) == " ") {
        key = str_slice(key, 0, strlen(key) - 1)
    }
    if strlen(key) != 64 {
        return ""
    }
    gateway_state_set("secure.k_gw", key)
    return key
}

// secure_plain_allowed is whether a plain frame is accepted: only when the
// deployment says so for a migration.
fn secure_plain_allowed() bool {
    return getenv("ALLOW_PLAIN_FRAMES") == "1"
}

fn secure_device_key(uid_hex: string) string {
    return str_slice(rho_hmac_sha256_hex(secure_gateway_key(), SECURE_LABEL_DEV + uid_hex), 0, 32)
}

// secure_now_s is the wall clock: a session's expiry stays right across a
// restart, which a store of sessions needs, and does not wrap after 49 days of
// uptime as the millisecond uptime counter does.
fn secure_now_s() u32 {
    return rho_now_s()
}

/* -------------------------------------------------------------------------- */
/*  Sessions kept across a restart                                            */
/* -------------------------------------------------------------------------- */

// secure_key_dir is the directory that holds the gateway's key, where the
// sessions and the node manifest are kept beside it: "" when the gateway has no
// key file, and "." when the key is named without a directory.
fn secure_key_dir() string {
    let key: string = getenv("GATEWAY_KEY_FILE")
    if key == "" {
        return ""
    }
    var at: i32 = -1
    var i: u32 = 0
    while i < strlen(key) {
        if str_slice(key, i, 1) == "/" {
            at = i32(i)
        }
        i = i + 1
    }
    if at < 0 {
        return "."
    }
    if at == 0 {
        return "/"
    }
    return str_slice(key, 0, u32(at))
}

// secure_store_path is where the live sessions are kept: GATEWAY_SESSION_FILE,
// or `sessions` beside the gateway's key — readable by the gateway's user alone,
// as the key is. "" when the gateway has no key, and so no sessions.
fn secure_store_path() string {
    let named: string = getenv("GATEWAY_SESSION_FILE")
    if named != "" {
        return named
    }
    let dir: string = secure_key_dir()
    if dir == "" {
        return ""
    }
    if dir == "." {
        return "sessions"
    }
    if dir == "/" {
        return "/sessions"
    }
    return dir + "/sessions"
}

// secure_live is whether a session id names a session that has not expired.
fn secure_live(sid: string) bool {
    if sid == "" {
        return false
    }
    let record: string = gateway_state_get("secure.sid." + sid)
    return record != "" && secure_now_s() < u32(int_from_str(secure_field(record, 3)))
}

// secure_sid_uid is the board a session was opened for, or "".
fn secure_sid_uid(sid: string) string {
    if sid == "" {
        return ""
    }
    return secure_field(gateway_state_get("secure.sid." + sid), 0)
}

// secure_list_has is whether a list kept as `,a,b,` holds an item.
fn secure_list_has(list: string, item: string) bool {
    return item != "" && str_index_of(list, "," + item + ",") >= 0
}

// secure_unroute forgets that a session's connection speaks for an area, when
// the route is still the one that session announced.
fn secure_unroute(sid: string, area: string) void {
    let child: u32 = gateway_state_get_u32("area." + area)
    if child != 0 && gateway_state_get("secure.child." + int_to_str(child) + ".sid") == sid {
        gateway_state_set_u32("area." + area, 0)
        gateway_state_set("secure.child." + int_to_str(child) + ".sid", "")
    }
}

// secure_drop_session forgets a session and everything that pointed at it: the
// routes its connection announced, and the serial link's hold on it. Its board
// has to say hello again, which a revoked board is not answered for.
fn secure_drop_session(sid: string) void {
    if sid == "" {
        return
    }
    let uid: string = secure_sid_uid(sid)
    var rest: string = gateway_state_get("secure.sid." + sid + ".areas")
    while rest != "" {
        let at: i32 = str_index_of(rest, ",")
        var area: string = rest
        if at < 0 {
            rest = ""
        } else {
            area = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        }
        if area != "" {
            secure_unroute(sid, area)
        }
    }
    gateway_state_set("secure.sid." + sid + ".areas", "")
    gateway_state_set("secure.sid." + sid + ".link", "")
    gateway_state_set("secure.sid." + sid + ".rekey", "")
    gateway_state_set("secure.sid." + sid + ".restored", "")
    gateway_state_set("secure.sid." + sid + ".reset", "")
    gateway_state_set("secure.sid." + sid, "")
    if gateway_state_get("secure.serial.sid") == sid {
        gateway_state_set("secure.serial.sid", "")
    }
    if gateway_state_get("secure.serial.pending") == sid {
        gateway_state_set("secure.serial.pending", "")
    }
    if uid != "" && gateway_state_get("secure.uid." + uid) == sid {
        gateway_state_set("secure.uid." + uid, gateway_state_get("secure.uid." + uid + ".pending"))
        gateway_state_set("secure.uid." + uid + ".pending", "")
    }
    if uid != "" && gateway_state_get("secure.uid." + uid + ".pending") == sid {
        gateway_state_set("secure.uid." + uid + ".pending", "")
    }
}

// secure_store writes every live session — `sid|uid|k_up|k_down|expiry|up|down|link|epoch`
// — the session the serial link holds and the one it is about to, each board's
// latest hello nonces and what happened to its key (gateway/keys.rho), and
// forgets the expired sessions. It is called
// when a session opens and when a counter has moved SECURE_STORE_EVERY past what
// was last kept, so a restart loses neither the sessions nor the counters'
// high-water marks.
fn secure_store() void {
    let path: string = secure_store_path()
    if path == "" {
        return
    }
    let now: u32 = secure_now_s()
    var out: string = ""
    var rest: string = gateway_state_get("secure.sids")
    var kept: string = ""
    while rest != "" {
        let at: i32 = str_index_of(rest, ",")
        var sid: string = rest
        if at < 0 {
            rest = ""
        } else {
            sid = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        }
        let record: string = gateway_state_get("secure.sid." + sid)
        if sid == "" || record == "" {
            continue
        }
        if now >= u32(int_from_str(secure_field(record, 3))) {
            // Expired: forgotten here as well as on disk.
            secure_drop_session(sid)
            continue
        }
        kept = kept + sid + ","
        out = out + sid + "|" + secure_field(record, 0) + "|" + secure_field(record, 1) + "|" + secure_field(record, 2) + "|" +
            secure_field(record, 3) + "|" + int_to_str(gateway_state_get_u32("secure.up." + sid)) + "|" +
            int_to_str(gateway_state_get_u32("secure.down." + sid)) + "|" + gateway_state_get("secure.sid." + sid + ".link") + "|" +
            int_to_str(u32(int_from_str(secure_field(record, 4)))) + "\n"
    }
    gateway_state_set("secure.sids", kept)
    out = out + "serial|" + gateway_state_get("secure.serial.sid") + "|" + gateway_state_get("secure.serial.pending") + "\n"
    var uids: string = gateway_state_get("secure.nonce_uids")
    while uids != "" {
        let at: i32 = str_index_of(uids, ",")
        var uid: string = uids
        if at < 0 {
            uids = ""
        } else {
            uid = str_slice(uids, 0, u32(at))
            uids = str_slice(uids, u32(at) + 1, strlen(uids) - u32(at) - 1)
        }
        let nonces: string = gateway_state_get("secure.nonces." + uid)
        if uid != "" && nonces != "" {
            out = out + "nonce|" + uid + "|" + nonces + "\n"
        }
    }
    out = out + keys_store_lines()
    if !rho_write_secret(path, out) {
        secure_log("the sessions could not be kept in " + path)
        return
    }
    // What is on disk now is the mark a counter is measured from.
    var marks: string = kept
    while marks != "" {
        let at: i32 = str_index_of(marks, ",")
        let sid: string = str_slice(marks, 0, u32(at))
        marks = str_slice(marks, u32(at) + 1, strlen(marks) - u32(at) - 1)
        gateway_state_set_u32("secure.up_saved." + sid, gateway_state_get_u32("secure.up." + sid))
        gateway_state_set_u32("secure.down_saved." + sid, gateway_state_get_u32("secure.down." + sid))
    }
}

// secure_restore takes back the sessions a previous run kept, at start: a board
// that holds one goes on sending under it, rather than going unheard until its
// session expires. A counter is kept once it has moved SECURE_STORE_EVERY past
// the last mark, so what was used before the restart is below the kept mark plus
// SECURE_STORE_EVERY; each starts at twice that past the mark, which leaves no
// frame recorded before the restart that could be replayed after it.
fn secure_restore() u32 {
    let path: string = secure_store_path()
    if path == "" {
        return 0
    }
    let now: u32 = secure_now_s()
    var restored: u32 = 0
    var sids: string = ""
    var uids: string = ""
    var rest: string = rho_read_text(path)
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        }
        let sid: string = secure_field(line, 0)
        if sid == "serial" {
            gateway_state_set("secure.serial.sid", secure_field(line, 1))
            gateway_state_set("secure.serial.pending", secure_field(line, 2))
            continue
        }
        if sid == "keys" {
            keys_restore(line)
            continue
        }
        if sid == "nonce" {
            let uid: string = secure_field(line, 1)
            if strlen(uid) == 16 && !secure_list_has("," + uids, uid) {
                gateway_state_set("secure.nonces." + uid, secure_field(line, 2))
                uids = uids + uid + ","
            }
            continue
        }
        let expiry: u32 = u32(int_from_str(secure_field(line, 4)))
        if strlen(sid) != 4 || expiry <= now {
            continue
        }
        let uid: string = secure_field(line, 1)
        let up: u32 = u32(int_from_str(secure_field(line, 5)))
        let down: u32 = u32(int_from_str(secure_field(line, 6)))
        // A session kept before epochs were is under epoch 0.
        gateway_state_set("secure.sid." + sid, uid + "|" + secure_field(line, 2) + "|" + secure_field(line, 3) + "|" +
            int_to_str(expiry) + "|" + int_to_str(u32(int_from_str(secure_field(line, 8)))))
        gateway_state_set_u32("secure.up." + sid, up + SECURE_STORE_EVERY + SECURE_STORE_EVERY)
        gateway_state_set_u32("secure.down." + sid, down + SECURE_STORE_EVERY + SECURE_STORE_EVERY)
        // The mark stays what the disk holds, so the first frame after the
        // restart moves the kept mark up past the restored counters.
        gateway_state_set_u32("secure.up_saved." + sid, up)
        gateway_state_set_u32("secure.down_saved." + sid, down)
        // Restored: what the board last sent lies somewhere in (up, mark], and
        // a frame of its in that window is the cue to ask it for a new session
        // (secure_reset_restored). The downward counter needs nothing more: it
        // is restored past anything the board accepted, by the same margin, so
        // the board takes the request.
        gateway_state_set("secure.sid." + sid + ".restored", int_to_str(up) + "|" +
            int_to_str(up + SECURE_STORE_EVERY + SECURE_STORE_EVERY))
        gateway_state_set("secure.sid." + sid + ".reset", "")
        gateway_state_set("secure.uid." + uid + ".restored", "1")
        gateway_state_set("secure.uid." + uid, sid)
        // The link a session is held to comes back with it when it names one
        // that outlives a restart: the serial link, or the relay a board is
        // behind. A connection number does not: the connection is gone.
        let link: string = secure_field(line, 7)
        if link == "serial" || str_index_of(link, "via:") == 0 {
            gateway_state_set("secure.sid." + sid + ".link", link)
        } else {
            gateway_state_set("secure.sid." + sid + ".link", "")
        }
        sids = sids + sid + ","
        restored = restored + 1
    }
    gateway_state_set("secure.sids", sids)
    gateway_state_set("secure.nonce_uids", uids)
    if restored > 0 {
        secure_log(int_to_str(restored) + " sessions restored")
    }
    return restored
}

// secure_hello_seen is whether a board has said hello with this nonce before:
// a recorded hello, sent again. Its latest SECURE_NONCES_KEPT nonces are
// remembered, and kept with the sessions across a restart.
fn secure_hello_seen(uid: string, nonce_b: string) bool {
    return secure_list_has("," + gateway_state_get("secure.nonces." + uid), nonce_b)
}

// secure_hello_remember records a nonce a board's hello was answered for.
fn secure_hello_remember(uid: string, nonce_b: string) void {
    var nonces: string = gateway_state_get("secure.nonces." + uid) + nonce_b + ","
    // Each nonce is 16 hex digits and a comma.
    while strlen(nonces) > SECURE_NONCES_KEPT * 17 {
        nonces = str_slice(nonces, 17, strlen(nonces) - 17)
    }
    gateway_state_set("secure.nonces." + uid, nonces)
    if !secure_list_has("," + gateway_state_get("secure.nonce_uids"), uid) {
        gateway_state_set("secure.nonce_uids", gateway_state_get("secure.nonce_uids") + uid + ",")
    }
}

// secure_bad_hello says a hello did not authenticate — at most once a
// minute, with how many were not said, so a flood of forged hellos does not
// become a flood of log lines.
fn secure_bad_hello(uid: string) void {
    let now: u32 = secure_now_s()
    let last: u32 = gateway_state_get_u32("secure.bad_hello_at")
    let quiet: u32 = gateway_state_get_u32("secure.bad_hello_quiet")
    if last != 0 && now - last < SECURE_BAD_HELLO_QUIET_S {
        gateway_state_set_u32("secure.bad_hello_quiet", quiet + 1)
        return
    }
    gateway_state_set_u32("secure.bad_hello_at", now)
    gateway_state_set_u32("secure.bad_hello_quiet", 0)
    if quiet > 0 {
        secure_log("a hello did not authenticate: uid " + uid + " (and " + int_to_str(quiet) +
            " more since the last said)")
        return
    }
    secure_log("a hello did not authenticate: uid " + uid)
}

// secure_accept_hello opens a session for a board's hello and returns
// `<sid>|<encoded session frame>`, the answer to send back on the link the hello
// came from, or "" when the hello is not answered. A hello whose tag does not
// match the board's key is not.
fn secure_accept_hello(payload: string) string {
    let accepted: string = secure_accept_hello_answer(payload)
    if accepted == "" {
        return ""
    }
    return str_slice(accepted, 0, 5) + robohub_v1_frame(MESSAGE_ID_SECURE_SESSION, 0,
        str_slice(accepted, 5, strlen(accepted) - 5))
}

// secure_accept_hello_answer opens a session for a board's hello and returns
// `<sid>|<session payload>`: the answer's bytes, for a caller that frames it
// itself — inside a RELAYED message, for a board behind a relay. "" when the
// hello is not answered.
fn secure_accept_hello_answer(payload: string) string {
    if strlen(payload) != 24 {
        return ""
    }
    // A board asking for a session from a gateway with no key is not answered;
    // that is said once, since it is why a sealed board goes unheard.
    if secure_gateway_key() == "" {
        if gateway_state_get("secure.nokey_warned") == "" {
            gateway_state_set("secure.nokey_warned", "1")
            secure_log("a board asked for a session, but GATEWAY_KEY_FILE (" + getenv("GATEWAY_KEY_FILE") +
                ") holds no key of 64 hex digits; sealed boards are not heard")
        }
        return ""
    }
    let uid: string = secure_hex(str_slice(payload, 0, 8))
    let nonce_b: string = secure_hex(str_slice(payload, 8, 8))
    let tag: string = secure_hex(str_slice(payload, 16, 8))
    // The key is the one of the epoch the manifest names for the board, or of
    // the one before it while the board has not confirmed the new one.
    manifest_refresh(false)
    let found: i32 = keys_hello_epoch(uid, SECURE_LABEL_HELLO + uid + nonce_b, tag)
    if found < 0 {
        secure_bad_hello(uid)
        return ""
    }
    let epoch: u32 = u32(found)
    let k_dev: string = keys_device_key(uid, epoch)
    // A hello is answered once: the same nonce again is a recording.
    if secure_hello_seen(uid, nonce_b) {
        let replayed: u32 = gateway_state_get_u32("secure.hello_replayed")
        gateway_state_set_u32("secure.hello_replayed", replayed + 1)
        manifest_say(uid, "replay", "a hello from board " + uid + " was refused: it repeats one already answered")
        return ""
    }
    // A board the node manifest does not list, or lists as revoked, is not
    // given a session, however well its key derives.
    let refused: string = manifest_refusal(uid)
    if refused != "" {
        manifest_say(uid, "hello", "a hello from board " + uid + " was refused: " + refused)
        return ""
    }
    let random: string = rho_random_hex(10)
    if strlen(random) != 20 {
        secure_log("no random source: the hello from " + uid + " was not answered")
        return ""
    }
    // A session id is 16 bits: one still in use is never given out again, which
    // would put another board's frames under this one's keys. When every try
    // lands on a live one the hello is refused, rather than a session lost.
    var sid: string = str_slice(random, 0, 4)
    var tries: u32 = 0
    while tries < 8 && secure_live(sid) {
        let more: string = rho_random_hex(2)
        if strlen(more) == 4 {
            sid = more
        }
        tries = tries + 1
    }
    if secure_live(sid) {
        secure_log("no free session id: the hello from " + uid + " was refused")
        return ""
    }
    // An expired session under the same id leaves nothing behind it.
    secure_drop_session(sid)
    let nonce_g: string = str_slice(random, 4, 16)
    let lifetime: string = secure_hex(robohub_v1_put_u16(u16(SECURE_LIFETIME_S)))
    let session_tag: string = secure_tag(k_dev, SECURE_LABEL_SESSION + uid + nonce_b + sid + nonce_g + lifetime)
    let k_up: string = str_slice(rho_hmac_sha256_hex(k_dev, SECURE_LABEL_UP + nonce_b + nonce_g), 0, 32)
    let k_down: string = str_slice(rho_hmac_sha256_hex(k_dev, SECURE_LABEL_DOWN + nonce_b + nonce_g), 0, 32)
    gateway_state_set("secure.sid." + sid, uid + "|" + k_up + "|" + k_down + "|" +
        int_to_str(secure_now_s() + SECURE_LIFETIME_S) + "|" + int_to_str(epoch))
    gateway_state_set("secure.sid." + sid + ".rekey", "")
    gateway_state_set_u32("secure.up." + sid, 0)
    gateway_state_set_u32("secure.down." + sid, 0)
    gateway_state_set_u32("secure.up_saved." + sid, 0)
    gateway_state_set_u32("secure.down_saved." + sid, 0)
    // A board that already holds a live session keeps it as the one frames to
    // it are sealed under until a frame comes under the new one: a hello alone
    // does not move where its commands go.
    if secure_live(gateway_state_get("secure.uid." + uid)) {
        gateway_state_set("secure.uid." + uid + ".pending", sid)
    } else {
        gateway_state_set("secure.uid." + uid, sid)
        gateway_state_set("secure.uid." + uid + ".pending", "")
    }
    gateway_state_set("secure.sid." + sid + ".link", "")
    secure_hello_remember(uid, nonce_b)
    if str_index_of("," + gateway_state_get("secure.sids"), "," + sid + ",") < 0 {
        gateway_state_set("secure.sids", gateway_state_get("secure.sids") + sid + ",")
    }
    var under: string = ""
    if epoch > 0 {
        under = " under key epoch " + int_to_str(epoch)
    }
    secure_log("session " + sid + " opened for board " + uid + under)
    keys_opened(uid, epoch, sid)
    secure_store()
    return sid + "|" + secure_bytes(uid + sid + nonce_g + lifetime + session_tag)
}

// secure_handle_hello answers a hello heard on this gateway's serial link, on
// that link. The new session becomes the one frames down the link are sealed
// under once a frame sealed under it has come up — so a hello replayed onto the
// link cannot take the link from the board that holds it — or at once when the
// link holds no live session.
fn secure_handle_hello(payload: string) void {
    let accepted: string = secure_accept_hello(payload)
    if accepted == "" {
        return
    }
    let sid: string = secure_field(accepted, 0)
    gateway_state_set("secure.sid." + sid + ".link", "serial")
    if secure_live(gateway_state_get("secure.serial.sid")) {
        gateway_state_set("secure.serial.pending", sid)
    } else {
        gateway_state_set("secure.serial.sid", sid)
        gateway_state_set("secure.serial.pending", "")
    }
    secure_store()
    if !gateway_serial_write(str_slice(accepted, strlen(sid) + 1, strlen(accepted) - strlen(sid) - 1)) {
        secure_log("session " + sid + " could not be written to the link")
    }
}

// secure_handle_uplink_hello answers a hello that came up an uplink connection —
// a board on Wi-Fi, or a relay below this gateway — on that connection, and
// remembers which session the connection holds.
fn secure_handle_uplink_hello(payload: string, connection: u32) void {
    let accepted: string = secure_accept_hello(payload)
    if accepted == "" {
        return
    }
    let sid: string = secure_field(accepted, 0)
    gateway_state_set("secure.conn." + int_to_str(connection) + ".sid", sid)
    gateway_state_set("secure.sid." + sid + ".link", "conn:" + int_to_str(connection))
    secure_store()
    if !gateway_uplink_reply(connection, str_slice(accepted, strlen(sid) + 1, strlen(accepted) - strlen(sid) - 1)) {
        secure_log("session " + sid + " could not be written to its connection")
    }
}

fn secure_field(record: string, index: u32) string {
    var rest: string = record
    var i: u32 = 0
    while i < index {
        let at: i32 = str_index_of(rest, "|")
        if at < 0 {
            return ""
        }
        rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        i = i + 1
    }
    let end: i32 = str_index_of(rest, "|")
    if end < 0 {
        return rest
    }
    return str_slice(rest, 0, u32(end))
}

fn secure_refused() TransportFrame {
    var frame: TransportFrame
    frame.ok = false
    let refused: u32 = gateway_state_get_u32("secure.refused")
    gateway_state_set_u32("secure.refused", refused + 1)
    return frame
}

// secure_open opens a secured frame: the session must be current and one of
// the two the link it arrived on holds (an id from anywhere else is refused, so
// a session is bound to its connection), the counter greater than the last
// accepted, and the tag the session's. The frame handed on carries the message
// id without the flag and the payload inside.
fn secure_open(frame: TransportFrame, bound: string, also: string) TransportFrame {
    let payload: string = frame.payload
    if strlen(payload) < 14 {
        return secure_refused()
    }
    let sid: string = secure_hex(str_slice(payload, 0, 2))
    if sid != bound && sid != also {
        return secure_refused()
    }
    let record: string = gateway_state_get("secure.sid." + sid)
    if record == "" || secure_now_s() >= u32(int_from_str(secure_field(record, 3))) {
        return secure_refused()
    }
    let counter: u32 = robohub_v1_get_u32(payload, 2)
    if counter <= gateway_state_get_u32("secure.up." + sid) {
        // A board going on under a session restored after a restart, below
        // the restored mark: asked for a new session rather than left unheard.
        if secure_restored_window(frame, sid, record, counter) {
            secure_reset_restored(sid, 0)
        }
        return secure_refused()
    }
    if !secure_tag_ok(frame, record) {
        return secure_refused()
    }
    let body_length: u32 = strlen(payload) - 14
    let inner: string = str_slice(payload, 6, body_length)
    gateway_state_set_u32("secure.up." + sid, counter)
    // The first frame under a board's new session makes it the one frames to
    // the board are sealed under.
    let uid: string = secure_field(record, 0)
    if gateway_state_get("secure.uid." + uid + ".pending") == sid {
        gateway_state_set("secure.uid." + uid, sid)
        gateway_state_set("secure.uid." + uid + ".pending", "")
    }
    // ... and the sessions of the board's restored after a restart are done
    // with once a new one carries a frame.
    if !secure_restored(sid) && gateway_state_get("secure.uid." + uid + ".restored") != "" {
        secure_drop_restored(uid, sid)
    }
    if counter >= gateway_state_get_u32("secure.up_saved." + sid) + SECURE_STORE_EVERY {
        secure_store()
    }
    // A board that has just shown it holds this session is moved to the
    // manifest's key epoch when its session is under an older one.
    if frame.msg_id - SECURE_FLAG != MESSAGE_ID_REKEY_ACK {
        keys_rekey_due(sid)
    }
    var opened: TransportFrame
    opened.ok = true
    opened.msg_id = frame.msg_id - SECURE_FLAG
    opened.tx_id = frame.tx_id
    opened.payload = inner
    return opened
}

// secure_tag_ok is whether a sealed frame's tag is the one the session's upward
// key makes for it.
fn secure_tag_ok(frame: TransportFrame, record: string) bool {
    let payload: string = frame.payload
    if strlen(payload) < 14 {
        return false
    }
    let body_length: u32 = strlen(payload) - 14
    let header: string = secure_hex(robohub_v1_put_u16(u16(frame.msg_id)) + robohub_v1_put_u16(u16(frame.tx_id)))
    let expected: string = secure_tag(secure_field(record, 1),
        header + secure_hex(str_slice(payload, 0, 6)) + secure_hex(str_slice(payload, 6, body_length)))
    return secure_equal(expected, secure_hex(str_slice(payload, 6 + body_length, 8)))
}

/* -------------------------------------------------------------------------- */
/*  Sessions restored after a restart                                         */
/* -------------------------------------------------------------------------- */

// secure_restored is whether a session is one this run took back from disk,
// and no new session of its board has replaced it yet.
fn secure_restored(sid: string) bool {
    return sid != "" && gateway_state_get("secure.sid." + sid + ".restored") != ""
}

// secure_restored_window is whether a frame refused for its counter is its
// board going on under a restored session: the tag is the session's, and the
// counter lies past what was kept and at or below the mark restored — what the
// board may have sent before the restart, or since, as it kept counting.
fn secure_restored_window(frame: TransportFrame, sid: string, record: string, counter: u32) bool {
    if !secure_restored(sid) {
        return false
    }
    let marks: string = gateway_state_get("secure.sid." + sid + ".restored")
    let saved: u32 = u32(int_from_str(secure_field(marks, 0)))
    let mark: u32 = u32(int_from_str(secure_field(marks, 1)))
    return counter > saved && counter <= mark && secure_tag_ok(frame, record)
}

// secure_restored_elsewhere is whether a frame refused on an uplink connection
// is its board going on under a session restored after a restart: the session
// was held to a connection the restart closed, so no connection holds it now.
// The board is asked for a new session on the connection the frame came on.
fn secure_restored_elsewhere(frame: TransportFrame, connection: u32) void {
    let sid: string = secure_frame_sid(frame)
    if !secure_restored(sid) || secure_sid_link(sid) != "" || strlen(frame.payload) < 14 {
        return
    }
    let record: string = gateway_state_get("secure.sid." + sid)
    if record == "" || secure_now_s() >= u32(int_from_str(secure_field(record, 3))) {
        return
    }
    let saved: u32 = u32(int_from_str(secure_field(gateway_state_get("secure.sid." + sid + ".restored"), 0)))
    if robohub_v1_get_u32(frame.payload, 2) <= saved || !secure_tag_ok(frame, record) {
        return
    }
    secure_reset_restored(sid, connection)
}

// secure_reset_restored asks the board that holds a restored session to drop
// it and say hello again: a SESSION_RESET sealed under that session, down the
// link it is held to — the serial link, or inside RELAYED through the relay a
// board is behind — or, when connection is not 0, on that uplink connection. At
// most once in SECURE_RESET_RETRY_S, SECURE_RESET_TRIES times, per session.
fn secure_reset_restored(sid: string, connection: u32) bool {
    if !secure_restored(sid) || !secure_live(sid) {
        return false
    }
    if connection == 0 && secure_sid_link(sid) == "" {
        return false
    }
    let sent: string = gateway_state_get("secure.sid." + sid + ".reset")
    let tries: u32 = u32(int_from_str(secure_field(sent, 1)))
    let now: u32 = secure_now_s()
    if sent != "" && (tries >= SECURE_RESET_TRIES || now - u32(int_from_str(secure_field(sent, 0))) < SECURE_RESET_RETRY_S) {
        return false
    }
    gateway_state_set("secure.sid." + sid + ".reset", int_to_str(now) + "|" + int_to_str(tries + 1))
    let reason: string = str_from_byte(u8(SECURE_RESET_REASON_RESTART))
    var written: bool = false
    if connection != 0 {
        written = gateway_uplink_reply(connection, secure_seal(sid, MESSAGE_ID_SESSION_RESET, 0, reason))
    } else {
        written = secure_send(sid, MESSAGE_ID_SESSION_RESET, 0, reason)
    }
    let uid: string = secure_sid_uid(sid)
    if !written {
        secure_log("session " + sid + " restored after restart: the request for board " + uid +
            " to start a new session could not be sent")
        return false
    }
    gateway_state_set_u32("secure.resets", gateway_state_get_u32("secure.resets") + 1)
    secure_log("session " + sid + " restored after restart: asked board " + uid + " to start a new session")
    return true
}

// secure_serial_opened asks every board that holds a restored session on the
// serial link for a new one, as soon as the link is open.
fn secure_serial_opened() void {
    var rest: string = gateway_state_get("secure.sids")
    while rest != "" {
        let at: i32 = str_index_of(rest, ",")
        var sid: string = rest
        if at < 0 {
            rest = ""
        } else {
            sid = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        }
        if secure_restored(sid) && secure_sid_link(sid) == "serial" {
            ignore_bool_secure(secure_reset_restored(sid, 0))
        }
    }
}

fn ignore_bool_secure(value: bool) void {
}

// secure_drop_restored drops a board's restored sessions once a new session of
// its, sid, has carried a frame.
fn secure_drop_restored(uid: string, sid: string) void {
    gateway_state_set("secure.uid." + uid + ".restored", "")
    var dropped: bool = false
    var rest: string = gateway_state_get("secure.sids")
    while rest != "" {
        let at: i32 = str_index_of(rest, ",")
        var old: string = rest
        if at < 0 {
            rest = ""
        } else {
            old = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        }
        if old != sid && secure_restored(old) && secure_sid_uid(old) == uid {
            secure_drop_session(old)
            secure_log("session " + old + " restored after restart is dropped: board " + uid + " holds session " + sid + " now")
            dropped = true
        }
    }
    if dropped {
        secure_store()
    }
}

// secure_open_serial opens a frame from the serial link, under the session the
// link holds or the one a hello on it has just opened; the first frame under the
// new one makes it the link's.
fn secure_open_serial(frame: TransportFrame) TransportFrame {
    let pending: string = gateway_state_get("secure.serial.pending")
    // Another board on the same serial bus holds its own session on the link.
    let named: string = secure_frame_sid(frame)
    if named != "" && named != pending && named != gateway_state_get("secure.serial.sid") &&
        gateway_state_get("secure.sid." + named + ".link") == "serial" {
        return secure_open(frame, named, named)
    }
    let opened: TransportFrame = secure_open(frame, gateway_state_get("secure.serial.sid"), pending)
    if opened.ok && pending != "" && secure_frame_sid(frame) == pending {
        gateway_state_set("secure.serial.sid", pending)
        gateway_state_set("secure.serial.pending", "")
        secure_store()
    }
    return opened
}

// secure_open_uplink opens a frame from one uplink connection, under the session
// that connection opened and no other.
fn secure_open_uplink(frame: TransportFrame, connection: u32) TransportFrame {
    let bound: string = gateway_state_get("secure.conn." + int_to_str(connection) + ".sid")
    if bound == "" || secure_frame_sid(frame) != bound {
        // A board going on under a session restored after a restart, on the
        // new connection it dialled: asked for a new session there.
        secure_restored_elsewhere(frame, connection)
        return secure_refused()
    }
    return secure_open(frame, bound, bound)
}

// secure_frame_sid is the session id a sealed frame names, as 4 hex digits.
fn secure_frame_sid(frame: TransportFrame) string {
    if strlen(frame.payload) < 2 {
        return ""
    }
    return secure_hex(str_slice(frame.payload, 0, 2))
}

// secure_frame_source is the board a sealed frame came from: the id its session
// was opened with, as 16 hex digits, or "" when the session is unknown. It is
// asked after secure_open accepted the frame, so the session is current.
fn secure_frame_source(frame: TransportFrame) string {
    if strlen(frame.payload) < 2 {
        return ""
    }
    let record: string = gateway_state_get("secure.sid." + secure_hex(str_slice(frame.payload, 0, 2)))
    if record == "" {
        return ""
    }
    return secure_field(record, 0)
}

// secure_frame_down is the encoded frame for a message to the board on this
// gateway's serial link: sealed under its session when it has one, plain when
// plain frames are allowed, and "" when neither, so nothing unauthenticated is
// sent to a board that expects authentication.
fn secure_frame_down(msg_id: u32, tx_id: u32, payload: string) string {
    let sid: string = gateway_state_get("secure.serial.sid")
    if !secure_live(sid) {
        if secure_plain_allowed() {
            return robohub_v1_frame(msg_id, tx_id, payload)
        }
        return ""
    }
    return secure_seal(sid, msg_id, tx_id, payload)
}

// secure_seal is the encoded frame for a message sealed under one session, and
// "" when the session is not current. It is never plain: a frame for an uplink
// connection is sealed or not sent, whatever ALLOW_PLAIN_FRAMES says.
fn secure_seal(sid: string, msg_id: u32, tx_id: u32, payload: string) string {
    let sealed: string = secure_seal_payload(sid, msg_id, tx_id, payload)
    if sealed == "" {
        return ""
    }
    return robohub_v1_frame(msg_id + SECURE_FLAG, tx_id, sealed)
}

// secure_seal_payload is the sealed payload — sid, counter, payload and tag —
// for a message under one session, sent with the id msg_id + SECURE_FLAG; ""
// when the session is not current.
fn secure_seal_payload(sid: string, msg_id: u32, tx_id: u32, payload: string) string {
    if !secure_live(sid) {
        return ""
    }
    let record: string = gateway_state_get("secure.sid." + sid)
    let counter: u32 = gateway_state_get_u32("secure.down." + sid) + 1
    gateway_state_set_u32("secure.down." + sid, counter)
    if counter >= gateway_state_get_u32("secure.down_saved." + sid) + SECURE_STORE_EVERY {
        secure_store()
    }
    let flagged: u32 = msg_id + SECURE_FLAG
    let sid_counter: string = secure_bytes(sid) + robohub_v1_put_u32(counter)
    let header: string = secure_hex(robohub_v1_put_u16(u16(flagged)) + robohub_v1_put_u16(u16(tx_id)))
    let tag: string = secure_tag(secure_field(record, 2), header + secure_hex(sid_counter) + secure_hex(payload))
    return sid_counter + payload + secure_bytes(tag)
}

/* -------------------------------------------------------------------------- */
/*  Where a session's frames go                                               */
/* -------------------------------------------------------------------------- */

// secure_sid_link is the link a session is held to: `serial`, `conn:<n>` for an
// uplink connection, `via:<relay uid>:<port>` for a board behind a relay,
// `http` for one that posted its hello, or "" when it is not known. A session
// the serial link holds from before links were kept is the serial link's.
fn secure_sid_link(sid: string) string {
    if sid == "" {
        return ""
    }
    let link: string = gateway_state_get("secure.sid." + sid + ".link")
    if link != "" {
        return link
    }
    if sid == gateway_state_get("secure.serial.sid") || sid == gateway_state_get("secure.serial.pending") {
        return "serial"
    }
    return ""
}

// secure_uid_sid is the session frames to a board go under: the one it holds,
// or — when that one is gone, or reaches no link — the one its latest hello
// opened. "" when it holds none.
fn secure_uid_sid(uid: string) string {
    if uid == "" {
        return ""
    }
    let current: string = gateway_state_get("secure.uid." + uid)
    let pending: string = gateway_state_get("secure.uid." + uid + ".pending")
    if secure_live(current) && secure_sid_link(current) != "" {
        return current
    }
    if secure_live(pending) {
        return pending
    }
    if secure_live(current) {
        return current
    }
    return ""
}

// secure_relayed_payload is a RELAYED payload: the port, the inner frame's id
// and transaction, and its payload (robohub/protocol, MessageId.RELAYED).
fn secure_relayed_payload(port: u32, msg_id: u32, tx_id: u32, payload: string) string {
    return str_from_byte(u8(port)) + robohub_v1_put_u16(u16(msg_id)) + robohub_v1_put_u16(u16(tx_id)) + payload
}

// secure_send sends a message to the board that holds a session, sealed under
// it, on the link the session is held to: the serial link, the uplink
// connection it was opened on, or — for a board behind a relay — inside a
// RELAYED message sealed under the relay's own session, to the relay's link.
// It answers whether the frame was written.
fn secure_send(sid: string, msg_id: u32, tx_id: u32, payload: string) bool {
    return secure_send_depth(sid, msg_id, tx_id, payload, 0)
}

fn secure_send_depth(sid: string, msg_id: u32, tx_id: u32, payload: string, depth: u32) bool {
    let link: string = secure_sid_link(sid)
    if str_index_of(link, "via:") == 0 {
        // A relay behind a relay is two hops; more than a few is a loop.
        if depth >= 4 {
            return false
        }
        let rest: string = str_slice(link, 4, strlen(link) - 4)
        let colon: i32 = str_index_of(rest, ":")
        if colon < 0 {
            return false
        }
        let relay_sid: string = secure_uid_sid(str_slice(rest, 0, u32(colon)))
        let port: u32 = u32(int_from_str(str_slice(rest, u32(colon) + 1, strlen(rest) - u32(colon) - 1)))
        if relay_sid == "" || relay_sid == sid {
            return false
        }
        let sealed: string = secure_seal_payload(sid, msg_id, tx_id, payload)
        if sealed == "" {
            return false
        }
        return secure_send_depth(relay_sid, MESSAGE_ID_RELAYED, 0,
            secure_relayed_payload(port, msg_id + SECURE_FLAG, tx_id, sealed), depth + 1)
    }
    return secure_link_write(sid, secure_seal(sid, msg_id, tx_id, payload))
}

// secure_link_write writes an encoded frame on the link a session is held to.
fn secure_link_write(sid: string, encoded: string) bool {
    if encoded == "" {
        return false
    }
    let link: string = secure_sid_link(sid)
    if link == "serial" {
        return gateway_serial_write(encoded)
    }
    if str_index_of(link, "conn:") == 0 {
        return gateway_uplink_reply(u32(int_from_str(str_slice(link, 5, strlen(link) - 5))), encoded)
    }
    return false
}

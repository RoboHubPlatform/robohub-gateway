module gateway

// robohub-gateway - the edge gateway for RoboHub firmware nodes.
//
// It reads COBS frames from a serial link, keeps the latest telemetry, streams
// each reading to PlotJuggler over UDP, and serves the same state and the RPC
// that changes a node's sampling rate over HTTP.
//
// The host primitives it needs are declared in gateway/port.rho and supplied by
// the `gateway` port; the wire grammar and the routing are the Rho below.

// The host declarations, the generated protocol and transport, and the pieces
// of the gateway. `include` keeps them in this module, so an extern's name is
// the name the generated port implements and no call is qualified.
//
// The wire is generated from schemas/gateway.rho — both protocol levels in one
// declaration, so a message means the same thing on a board's link (L2) and on
// a gateway's uplink (L1).
include "gateway/port.rho"
include "gateway/security.rho"
include "gateway/wire/protocol.rho"
include "gateway/secure.rho"
include "gateway/ingest.rho"
include "gateway/stream.rho"
include "gateway/history.rho"
include "gateway/devices.rho"
include "gateway/outbox.rho"
include "gateway/state.rho"
include "gateway/relay.rho"

import std.web.http

route GET  "/" => home
route GET  "/frames/{count}" => frames
route GET  "/export/frames/{count}/csv" => export_frames_csv
route GET  "/api/v1/telemetry/temperature" => latest_temperature
route GET  "/api/v1/telemetry/power" => latest_power
route GET  "/api/v1/telemetry/state" => latest_state
route GET  "/api/v1/telemetry/outbox" => outbox_fetch
route POST "/api/v1/telemetry/ack" => outbox_ack
route GET  "/api/v1/telemetry/outbox/status" => outbox_status
route GET  "/api/v1/nodes" => nodes
route GET  "/api/v1/nodes/{area}/{node}/diagnostics" => device_diagnostics
route POST "/api/v1/nodes/{area}/{node}/sampling-rate" => device_sampling_rate
route POST "/api/v1/nodes/{area}/{node}/command" => device_command
route POST "/api/v1/nodes/{area}/{node}/switch" => device_switch
route GET  "/api/v1/diagnostics" => diagnostics
route POST "/api/v1/telemetry/sampling-rate" => set_sampling_rate
route POST "/api/v1/frames" => ingest_http_frame
route POST "/api/v1/devices" => device_register
route GET "/api/v1/devices" => device_list
route POST "/api/v1/devices/{id}/poll" => device_poll
route POST "/api/v1/devices/{id}/switch" => devices_switch
route POST "/api/v1/uplink/pump" => uplink_pump

// A liveness probe is registered by the router port for every service, so this
// module does not declare one; GET /healthz answers {"status":"ok"} already.

// init runs on every target before the service starts. Bringing the link up
// here means the first request already has a reader behind it.
// ingest_http_frame accepts an encoded frame from a network bridge. A Shelly
// or another IP device reaches the gateway through a relay or a small poller;
// the frame it posts is the same frame a serial link carries, so the reader,
// the state and the stream are the same.
fn ingest_http_frame(req: Request) Response {
    if !gateway_allowed(req, "command") {
        return gateway_denied()
    }
    let body: string = request_body(req)
    if strlen(body) == 0 {
        return json(400, "{\"success\":false}")
    }
    ingest_frame(body)
    return json(200, "{\"success\":true}")
}

fn init() void {
    // REST_PORT is the gateway's name for the listener; let it stand in for the
    // generated service's RHO_HTTP_ADDR before the address is chosen.
    gateway_config()
    // Sessions a previous run kept: a board that holds one is heard at once.
    if secure_restore() > 0 {
        print("robohub-gateway: boards that held a session are heard again\n")
    }
    print("robohub-gateway: starting as " + gateway_mode() +
        " in area " + int_to_str(gateway_area()) + "\n")
    // The uplink is where a relay dials in. A gateway with nothing above it —
    // a master, or an edge wired to a host — names no port and listens on none.
    let uplink: u32 = gateway_uplink_port()
    if uplink != 0 {
        if gateway_uplink_start(uplink) {
            print("robohub-gateway: uplink listening on port " + int_to_str(uplink) + "\n")
        }
    }
    // A relay reports through its parent: it dials the parent's uplink and
    // opens a session as a board of the parent's mesh (gateway/relay.rho).
    relay_start()
    if outbox_start() {
        print("robohub-gateway: outbox " + gateway_outbox_status() + "\n")
    } else {
        print("robohub-gateway: outbox disabled\n")
    }
}

// background runs on its own goroutine beside the HTTP listener. It owns the
// link: read a frame, route it, repeat. A link that cannot be opened is tried
// again, and the service answers all the while.
fn background() void {
    // The uplink is drained here as well as on a request, so whoever dials in —
    // a relay, a board on Wi-Fi — is answered while it waits for its session.
    // A link that is not there yet, or goes away — a board on USB that resets —
    // is opened again when it is back, every two seconds at most; the uplink is
    // served all the while.
    if !gateway_serial_start() {
        print("robohub-gateway: no serial link yet; it is opened when it appears\n")
    }
    gateway_udp_start()
    while true {
        if gateway_serial_start() {
            let frame: string = gateway_serial_read(20)
            if strlen(frame) > 0 {
                ingest_frame(frame)
            }
        } else {
            rho_sleep_ms(20)
        }
        drain_uplink()
        relay_tick()
    }
}
